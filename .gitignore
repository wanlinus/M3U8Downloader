# 构建产物
[Bb]in/
[Oo]bj/
publish/
*.user
*.suo

# 应用内下载的 FFmpeg（体积大，且属第三方构建，不入库）
# 注意：不要写成裸的 ffmpeg/ —— Windows 上 git 不区分大小写，那条规则会把
# 源码目录 src/M3U8Downloader.Core/Ffmpeg/ 一起忽略掉（曾因此漏提交三个源文件）。
**/ffmpeg/ffmpeg.exe
**/ffmpeg/ffprobe.exe
**/ffmpeg/ffplay.exe
**/ffmpeg/*.zip
**/ffmpeg/*.tar.xz

# 下载产物与临时文件（*.ts 指 MPEG-TS 视频；本项目没有 TypeScript 源文件）
*.ts
*.mp4
*.part
*.tmp

# IDE
.vs/
.vscode/*
!.vscode/launch.json
!.vscode/tauri-dev.mjs
.idea/

# 系统
Thumbs.db
desktop.ini
.DS_Store

# 诊断 / 临时目录
_diag/
_probe/
_verify/
*.log

# 运行期数据目录（程序目录下的 data\：设置 / 任务 / 下载历史 / 日志）
/data/
