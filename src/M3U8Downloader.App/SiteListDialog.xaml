<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="M3U8Downloader.SiteListDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="站点管理"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnSaveClick">

    <Grid Width="520" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 关键在于"填首页就行"：搜索入口是程序自己去首页读 <form> 得来的，
             不需要用户知道这个站的搜索路径长什么样 -->
        <TextBlock Grid.Row="0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="这些站会出现在搜索时的「站点」下拉框里。地址填站点首页即可 —— 搜索入口是程序自己从首页里找的，不用管这个站的搜索路径长什么样。" />

        <Border Grid.Row="1" BorderThickness="1" CornerRadius="6" MinHeight="180"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ListView ItemsSource="{x:Bind Items}" SelectionMode="None" MaxHeight="320"
                      Padding="4" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <!-- 同 SearchDialog：条目不拉伸的话，地址框那个 * 列会被压得很窄 -->
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8" Padding="4,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" FontSize="13"
                                     PlaceholderText="名称（可留空）"
                                     Text="{Binding Name, Mode=TwoWay}" />

                            <TextBox Grid.Column="1" FontSize="13"
                                     PlaceholderText="https://www.example.com"
                                     Text="{Binding Url, Mode=TwoWay}" />

                            <Button Grid.Column="2" Content="删除" FontSize="12" Padding="10,3"
                                    Click="OnRemove" Tag="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Content="添加站点" Click="OnAdd" />
            <Button Content="恢复内置站点" Click="OnRestoreBuiltIn"
                    ToolTipService.ToolTip="把内置的那几个站加回来（不会删掉你已经加的）" />
        </StackPanel>

        <!-- 校验失败的原因：只写字数不够，要说清是哪一行哪儿不对 -->
        <TextBlock x:Name="ErrorText" Grid.Row="3" FontSize="12" TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
    </Grid>
</ContentDialog>
