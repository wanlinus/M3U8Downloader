<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="M3U8Downloader.FetchNewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="续下更新"
    PrimaryButtonText="下载勾选的集"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <Grid Width="440" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 说明这次站点上新增了几集、哪些已经在磁盘上 -->
        <TextBlock x:Name="SummaryText" FontSize="12" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!--
            后台刷新的结果：列表先按本地保存的数据秒开，随后联网刷新，
            新更新的集会被补进下面这个列表。这一行说明刷新到了什么。
        -->
        <TextBlock x:Name="RefreshStatusText" Grid.Row="1" FontSize="12" TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Content="仅选新增" Click="OnSelectNewOnly" FontSize="12" Padding="10,3" />
            <Button Content="全选待补" Click="OnSelectAll" FontSize="12" Padding="10,3" />
            <Button Content="全不选" Click="OnSelectNone" FontSize="12" Padding="10,3" />
            <!-- 手动刷新集列表：后台自动刷新没连上站点，或用户就是想再拉一次时用 -->
            <Button x:Name="RefreshButton" Content="刷新集列表" Click="OnRefresh"
                    FontSize="12" Padding="10,3"
                    ToolTipService.ToolTip="重新从站点拉一次集列表，看看有没有更新的集" />
            <TextBlock x:Name="SelectionText" VerticalAlignment="Center" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="3" BorderThickness="1" CornerRadius="6"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ListView ItemsSource="{x:Bind Items}" SelectionMode="None" MaxHeight="320"
                      Padding="4" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <!-- 已下载的整行压暗、勾选框禁用：这是"文件夹里已经有文件"的那些集 -->
                        <Grid ColumnSpacing="10" Padding="4,5" Opacity="{Binding RowOpacity}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" MinWidth="0"
                                      IsEnabled="{Binding IsSelectable}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                            <!-- 「已下载」/「新增」/「上次失败」/「曾下载过，文件已不在」 -->
                            <TextBlock Grid.Column="2" Text="{Binding Note}" FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</ContentDialog>
