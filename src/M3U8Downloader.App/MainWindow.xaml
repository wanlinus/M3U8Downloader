<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="M3U8Downloader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:M3U8Downloader"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶部：标题与模式切换 ==================== -->
        <Border Grid.Row="0" Padding="16,14,16,12" BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="M3U8 视频下载器" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="多线程下载 · AES-128/192/256 解密 · 断点续传 · 自动跳过源站插播广告分片" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ToggleButton x:Name="SingleModeButton" Content="单文件下载"
                                  IsChecked="True" Click="OnModeSingle" MinWidth="118" />
                    <ToggleButton x:Name="BatchModeButton" Content="站点批量下载"
                                  IsChecked="False" Click="OnModeBatch" MinWidth="118" />
                    <ToggleButton x:Name="TaskModeButton" Content="下载任务"
                                  IsChecked="False" Click="OnModeTasks" MinWidth="100" />
                    <Button Content="设置" Click="OnOpenSettings" MinWidth="64" />
                    <Button Content="关于" Click="OnOpenAbout" MinWidth="64" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 模式一：单文件下载 ==================== -->
        <Grid x:Name="SinglePanel" Grid.Row="1" Padding="16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="M3U8 地址" VerticalAlignment="Center" Width="92" />
                    <TextBox Grid.Column="1" x:Name="UrlBox"
                             PlaceholderText="https://example.com/video/index.m3u8"
                             Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Referer" VerticalAlignment="Center" Width="92" />
                    <TextBox Grid.Column="1"
                             PlaceholderText="可选。部分站点的分片校验来源页，例如 https://www.example.com/play/1-1.html"
                             Text="{Binding Referer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Origin" VerticalAlignment="Center" Width="92" />
                    <TextBox Grid.Column="1"
                             PlaceholderText="可选。一般填站点根地址，例如 https://www.example.com"
                             Text="{Binding Origin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="User-Agent" VerticalAlignment="Center" Width="92" />
                    <TextBox Grid.Column="1"
                             Text="{Binding UserAgent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="保存目录" VerticalAlignment="Center" Width="92" />
                    <!-- 路径长了要能看全：换行显示（最多约三行），Enter 不换行仍保持单行输入手感 -->
                    <TextBox Grid.Column="1"
                             Text="{Binding OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="留空使用系统「下载」目录"
                             TextWrapping="Wrap" AcceptsReturn="False" MaxHeight="76" />
                    <Button Grid.Column="2" Content="选择…" Click="OnPickSingleFolder" />
                </Grid>

                <Grid Grid.Row="5" Grid.ColumnSpan="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="文件名" VerticalAlignment="Center" Width="92" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="并发数" VerticalAlignment="Center" />
                        <NumberBox Value="{Binding Concurrency, Mode=TwoWay}" Minimum="1" Maximum="64"
                                   SpinButtonPlacementMode="Compact" Width="110" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="重试" VerticalAlignment="Center" />
                        <NumberBox Value="{Binding MaxRetries, Mode=TwoWay}" Minimum="0" Maximum="10"
                                   SpinButtonPlacementMode="Compact" Width="100" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="1" BorderThickness="1" CornerRadius="6" Padding="10"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="运行日志" FontWeight="SemiBold" FontSize="13" />
                    <ScrollViewer Grid.Row="1" x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Logs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,1,0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Spacing="6">
                <ProgressBar Value="{Binding Progress}" Maximum="100" />
                <TextBlock Text="{Binding DetailText}" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid Grid.Row="3" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" VerticalAlignment="Center"
                          Content="自动跳过疑似插播广告/无效分片（推荐）"
                          IsChecked="{Binding AutoSkipAds, Mode=TwoWay}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="取消" Click="OnSingleCancel" IsEnabled="{Binding IsBusy}" />
                    <Button x:Name="SingleStartButton" Content="开始下载" Click="OnSingleStart"
                            IsEnabled="{Binding CanStart}"
                            Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ==================== 模式二：站点批量下载 ==================== -->
        <Grid x:Name="BatchPanel" Grid.Row="1" Padding="16" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 地址 / 目录 / 并发 -->
            <Grid Grid.Row="0" ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="播放页地址" VerticalAlignment="Center" Width="92" />
                    <TextBox Grid.Column="1" x:Name="PageUrlBox"
                             PlaceholderText="粘贴视频网站的播放页或详情页地址，例如 https://www.example.com/vodplay/12345-1-1.html"
                             Text="{Binding PageUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Click="OnParseSeries"
                            IsEnabled="{Binding CanParse}" Style="{ThemeResource AccentButtonStyle}"
                            MinWidth="150"
                            AutomationProperties.Name="{Binding ParseButtonText}">
                        <!-- 识别期间按钮里转圈：抓页面 + 可能过代理要好几秒，没有反馈会以为卡死 -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="16" Height="16"
                                          IsActive="{Binding IsBusy}"
                                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                          Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding ParseButtonText}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="保存目录" VerticalAlignment="Center" Width="92" />
                    <!-- 路径长了要能看全：换行显示（最多约三行），Enter 不换行仍保持单行输入手感 -->
                    <TextBox Grid.Column="1"
                             Text="{Binding OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="留空使用系统「下载」目录"
                             TextWrapping="Wrap" AcceptsReturn="False" MaxHeight="76" />
                    <Button Grid.Column="2" Content="选择…" Click="OnPickBatchFolder" />
                </Grid>

                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="同时下载集数" VerticalAlignment="Center" />
                    <NumberBox Value="{Binding EpisodeConcurrency, Mode=TwoWay}" Minimum="1" Maximum="8"
                               SpinButtonPlacementMode="Compact" Width="96" />
                    <TextBlock Text="每集分片并发" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <NumberBox Value="{Binding SegmentConcurrency, Mode=TwoWay}" Minimum="1" Maximum="64"
                               SpinButtonPlacementMode="Compact" Width="96" />
                </StackPanel>
                <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="提示：总连接数 ≈ 两数相乘，不要盲目调大" />
            </Grid>

            <!-- 剧集信息条 -->
            <Border Grid.Row="1" Padding="12,9" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    Visibility="{Binding HasSeriesVisibility}">
                <StackPanel Spacing="3">
                    <TextBlock Text="{Binding SeriesTitle}" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="{Binding SourceSummary}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding SiteInfo}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- 选集工具栏 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                        Visibility="{Binding HasSeriesVisibility}">
                <TextBlock Text="剧集列表" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- 视频源选择：识别后常驻，随时切换（多源站如 kktvs 有 21 个源） -->
                <TextBlock Text="视频源" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0" />
                <ComboBox ItemsSource="{Binding SourceOptions}"
                          SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                          DisplayMemberPath="Display"
                          MinWidth="170" FontSize="12" />

                <Button Content="全选" Click="OnSelectAll" FontSize="12" Padding="10,3" />
                <Button Content="全不选" Click="OnSelectNone" FontSize="12" Padding="10,3" />
                <TextBox x:Name="SelectionSpecBox" PlaceholderText="选集，如 1-8 或 1,3,5"
                         Width="120" FontSize="12" />
                <Button Content="应用选集" Click="OnApplySelection" FontSize="12" Padding="10,3" />
            </StackPanel>

            <!-- 剧集列表 -->
            <Border Grid.Row="3" x:Name="EpisodeListBorder" BorderThickness="1" CornerRadius="6"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ListView ItemsSource="{Binding VisibleEpisodes}" SelectionMode="None"
                          Padding="4" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <!-- 识别完成后整批列表项依次淡入，比"唰"地一下全冒出来自然 -->
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="18" />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="10" Padding="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" MinWidth="0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                           VerticalAlignment="Center" FontSize="13" />

                                <ProgressBar Grid.Column="2" Value="{Binding Percent}" Maximum="100"
                                             VerticalAlignment="Center" Height="4"
                                             Visibility="{Binding ProgressVisibility}" />

                                <TextBlock Grid.Column="3" Text="{Binding Status}" MinWidth="130"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- 总体进度 -->
            <StackPanel Grid.Row="4" Spacing="6">
                <ProgressBar Value="{Binding TotalProgress}" Maximum="100" />
                <TextBlock Text="{Binding DetailText}" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 操作区 -->
            <Grid Grid.Row="5" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" VerticalAlignment="Center"
                          Content="自动跳过疑似插播广告/无效分片（推荐）"
                          IsChecked="{Binding AutoSkipAds, Mode=TwoWay}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="加入下载队列" Click="OnBatchStart"
                            IsEnabled="{Binding CanDownload}"
                            Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ==================== 模式三：下载任务 ==================== -->
        <Grid x:Name="TaskPanel" Grid.Row="1" Padding="16" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 工具栏 -->
            <Grid Grid.Row="0" ColumnSpacing="12" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="下载任务" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SummaryText}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <!-- 实时速度：↓ 下载在前，↑ 上传在后（本程序不上传数据，且只在下载时才显示） -->
                    <TextBlock Text="{Binding SpeedText}" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding UploadSpeedText}" FontSize="13" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding ShowUploadSpeed, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="日志" Click="OnOpenTaskLogs" FontSize="12" Padding="10,4"
                            ToolTipService.ToolTip="打开诊断日志目录（每次启动一个文件：哪一轮下了哪几集、何时结束）" />
                    <Button Content="清理已完成" Click="OnClearFinishedTasks" FontSize="12" Padding="10,4" />
                </StackPanel>

                <!-- 恢复提示（关掉程序再打开时会显示上次的任务） -->
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding Notice}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- 空状态 -->
            <Border Grid.Row="1" BorderThickness="1" CornerRadius="6"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Visibility="{Binding HasNoTasks, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                    <TextBlock Text="还没有下载任务" FontSize="14" HorizontalAlignment="Center" />
                    <TextBlock FontSize="12" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="到「站点批量下载」里识别剧集，点「加入下载队列」即可" />
                </StackPanel>
            </Border>

            <!-- 任务列表 -->
            <Border Grid.Row="1" BorderThickness="1" CornerRadius="6"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Visibility="{Binding HasTasks, Converter={StaticResource BoolToVis}}">
                <ListView ItemsSource="{Binding Tasks}" SelectionMode="None" Padding="4"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <!--
                                整条任务 = 一个展开栏：
                                **标题行**就是任务速览（状态 / 剧名 / 站点与目录 / 分集进度 / 总进度 / 速度或说明），
                                展开后才是分集清单与操作按钮。
                                这样收起时也能一眼看清是哪部剧、下到哪了，界面上也不会再出现
                                "上面一行信息 + 下面一个只写着分集进度的标题"这种重复。
                            -->
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      VerticalAlignment="Top" IsExpanded="True" Padding="0,2,0,0">
                                <Expander.Header>
                                    <!--
                                        标题行分两排：上排是速览（状态 / 剧名·站点 / 分集进度 / 总进度 / 速度），
                                        下排单独放**完整的输出目录** —— 以前它跟剧名挤在一格里，
                                        被 MaxWidth 截成 "D:\wanli\Downlo…"，不看悬停提示根本不知道下到哪了。
                                    -->
                                    <Grid ColumnSpacing="10" RowSpacing="1" Padding="0,2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 状态：失败 / 下载中 / 已暂停 … -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StateText}" FontSize="13"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                                        <!-- 剧名 + 站点 -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{Binding Title}" />
                                            <TextBlock Text="{Binding SiteName}" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <!-- 分集进度：已完成 / 总数 -->
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding EpisodeCountText}" FontSize="11"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        <!-- 整体进度 -->
                                        <ProgressBar Grid.Row="0" Grid.Column="3" Value="{Binding Percent}" Maximum="100"
                                                     Width="120" Height="6" VerticalAlignment="Center" />

                                        <!-- 下载中=速度/耗时/已下载，停下=为什么停的 -->
                                        <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding DownloadStatusText}" FontSize="11"
                                                   MaxWidth="220" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   ToolTipService.ToolTip="{Binding MessageText}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        <!-- 完整输出目录（允许换行，不截断） -->
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"
                                                   Text="{Binding DisplayDirectory}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Expander.Header>

                                <StackPanel Spacing="6">
                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Episodes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- 左右各留 20px：分集清单原来紧贴卡片左边框，连缝隙都没有；20px 后集号与标题行内容大致对齐，进度条仍有 300px 以上 -->
                                                    <StackPanel Padding="20,3,20,2" Spacing="2">
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="190" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="56" />
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="100" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTipService.ToolTip="{Binding Title}" />
                                                            <ProgressBar Grid.Column="1" Value="{Binding Percent}"
                                                                         Maximum="100" Height="4"
                                                                         VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding PercentText}"
                                                                       FontSize="11" HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <!-- 分片计数：一集上千片时百分比会长时间不动，这片数才是"在动"的证据 -->
                                                            <TextBlock Grid.Column="3" Text="{Binding SegmentText}"
                                                                       FontSize="11" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Grid.Column="4" Text="{Binding StatusText}"
                                                                       FontSize="11" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Error}" FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- 按钮组也跟着留出 20px 右缩进，避免贴在边框上 -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                                                Margin="0,0,20,2">
                                        <Button Content="暂停" FontSize="12" Padding="10,4" Click="OnTaskPause"
                                                Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="继续下载" FontSize="12" Padding="10,4" Click="OnTaskResume"
                                                Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="取消" FontSize="12" Padding="10,4" Click="OnTaskCancel"
                                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="重试失败集" FontSize="12" Padding="10,4" Click="OnTaskRetryFailed"
                                                Visibility="{Binding NeedsRetry, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="下载报告" FontSize="12" Padding="10,4" Click="OnTaskOpenReport"
                                                Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="打开目录" FontSize="12" Padding="10,4" Click="OnTaskOpenFolder" />
                                        <Button Content="移除" FontSize="12" Padding="10,4" Click="OnTaskRemove" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</Window>
