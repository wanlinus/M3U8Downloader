<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="M3U8Downloader.PlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：剧名 · 集名 -->
        <TextBlock x:Name="TitleText" Grid.Row="0"
                   Margin="16,12,16,6" FontSize="14"
                   TextTrimming="CharacterEllipsis" />

        <!-- 播放区：传输控件（播放/暂停、进度、音量、全屏）由系统提供，不用自己画 -->
        <MediaPlayerElement x:Name="Player" Grid.Row="1"
                            AreTransportControlsEnabled="True"
                            AutoPlay="True"
                            Stretch="Uniform" />

        <!-- 底部：切集 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                    Margin="16,6,16,14" VerticalAlignment="Center">
            <Button x:Name="PrevButton" Content="上一集" FontSize="12" Padding="12,4"
                    Click="OnPrevious" />
            <Button x:Name="NextButton" Content="下一集" FontSize="12" Padding="12,4"
                    Click="OnNext" />
            <TextBlock x:Name="CounterText" FontSize="12" VerticalAlignment="Center"
                       Margin="6,0,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="ErrorText" FontSize="12" VerticalAlignment="Center"
                       Margin="10,0,0,0" TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
