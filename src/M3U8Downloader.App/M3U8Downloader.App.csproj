<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>M3U8Downloader</RootNamespace>
    <AssemblyName>M3U8Downloader</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 托盘图标是 Resources 里的 TaskbarIcon，图标文件必须随程序一起落盘 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <!--
      这里**故意不写** EnableMsixTooling。
      它是"单项目 MSIX 打包"的总开关，只有要生成 .msix 时才需要；本项目没有
      Package.appxmanifest，发布走 scripts/publish.ps1 的非打包自包含形态，用不上它。
      更要紧的是它会引入 MSIX 的部署目标（Deploy / vs.appxrecipe 那一套），
      IDE 据此以为"运行前要先部署应用包"，于是要求系统开启开发者模式 ——
      Rider 上就是这么被挡住的（报"此设备当前未处于开发者模式"）。
      我们是直接跑 exe 的，不需要旁加载。详见 docs/pitfalls.md 第 36 条。
    -->
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <!-- 使用自定义 Main（可捕获并落盘启动异常），禁掉 XAML 自动生成的入口 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- 自包含部署 Windows App SDK 运行时，用户无需另行安装 -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- 同时自包含 .NET 运行时，做到真正免安装（需指定 RID 发布） -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- 托盘图标的 ico 必须在运行目录里（IconSource 走的是应用目录的相对路径）；
         不显式写 CopyToOutputDirectory 的话 build 会带上、publish 会漏掉 -->
    <Content Include="Assets\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Data.Sqlite 不再单独引：存储实现都挪进了 Core，跟着项目引用传递过来 -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <!-- 系统托盘：WinUI 没有内置托盘 API，用 H.NotifyIcon 的 TaskbarIcon（托盘图标 + 气泡通知 + 效率模式） -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\M3U8Downloader.Core\M3U8Downloader.Core.csproj" />
  </ItemGroup>

</Project>
