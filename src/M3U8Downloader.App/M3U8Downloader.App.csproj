<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>M3U8Downloader</RootNamespace>
    <AssemblyName>M3U8Downloader</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 托盘图标是 Resources 里的 TaskbarIcon，图标文件必须随程序一起落盘 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <!--
      EnableMsixTooling **必须留着**，别被名字骗了。
      它看着像"打包成 .msix 的开关"（我们是非打包应用，WindowsPackageType=None），
      但它同时是 WinUI 把资源索引 M3U8Downloader.pri 带进 **publish** 的条件：
      Microsoft.WinUI.AppX.targets 里写着 OutputType==WinExe && EnableMsixTooling==true 才处理，
      而 Microsoft.WinUI.targets 把它的默认值定成 false。

      删掉它的真实后果（亲自踩过）：dotnet build 照常生成 bin 下的 .pri，
      但 dotnet publish **不会**把它复制到发布目录 —— 发布包缺 XAML 资源索引，
      双击启动报 XamlParseException（0x802B000A），窗口根本出不来。
      而"编译成功"和"publish 成功"都看不出一丝异常。
    -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <!-- 使用自定义 Main（可捕获并落盘启动异常），禁掉 XAML 自动生成的入口 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- 自包含部署 Windows App SDK 运行时，用户无需另行安装 -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- 同时自包含 .NET 运行时，做到真正免安装（需指定 RID 发布） -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- 托盘图标的 ico 必须在运行目录里（IconSource 走的是应用目录的相对路径）；
         不显式写 CopyToOutputDirectory 的话 build 会带上、publish 会漏掉 -->
    <Content Include="Assets\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Data.Sqlite 不再单独引：存储实现都挪进了 Core，跟着项目引用传递过来 -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <!-- 系统托盘：WinUI 没有内置托盘 API，用 H.NotifyIcon 的 TaskbarIcon（托盘图标 + 气泡通知 + 效率模式） -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\M3U8Downloader.Core\M3U8Downloader.Core.csproj" />
  </ItemGroup>

</Project>
