<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="M3U8Downloader.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="复制诊断信息"
    CloseButtonText="关闭"
    DefaultButton="Close">

    <!-- 与「设置」一致：ContentDialog 没有内置关闭按钮，右上角自己补一个 -->
    <ContentDialog.Title>
        <Grid ColumnSpacing="12" MinWidth="420">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="关于" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1" Click="OnCloseDialog" Width="32" Height="32" Padding="0"
                    Background="Transparent" BorderThickness="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="关闭"
                    ToolTipService.ToolTip="关闭">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel Spacing="12" Width="440">

            <!-- 标题 -->
            <StackPanel Spacing="2">
                <TextBlock x:Name="AppNameText" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 版权 -->
            <StackPanel Spacing="2">
                <TextBlock x:Name="CopyrightText" FontSize="12" TextWrapping="Wrap" />
                <HyperlinkButton x:Name="ProjectUrlLink" FontSize="12" Padding="0,2,0,0"
                                 Visibility="Collapsed" />
            </StackPanel>

            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <!-- 许可证 -->
            <StackPanel Spacing="2">
                <TextBlock Text="许可证" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="LicenseText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <!-- 运行环境 -->
            <StackPanel Spacing="2">
                <TextBlock Text="运行环境" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="RuntimeText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="PathsText" FontSize="11" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <!-- 第三方组件 -->
            <StackPanel Spacing="2">
                <TextBlock Text="第三方组件" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="ThirdPartyText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <TextBlock x:Name="CopyHintText" FontSize="12" Visibility="Collapsed"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       Text="✓ 诊断信息已复制到剪贴板" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
